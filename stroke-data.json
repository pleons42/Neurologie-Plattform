  "reversal": [
    {
      "id": "vka",
      "cat": "VKA",
      "icon": "",
      "name": "Vitamin-K-Antagonist",
      "brands": "Phenprocoumon (Marcumar®, Falithrom®), Warfarin (Coumadin®)",
      "steps": [
        "<strong>PPSB (4-Faktor-PCC, z.B. Beriplex®):</strong><br>INR 2,0–3,9 → 25 IE/kg IV &nbsp;|&nbsp; INR 4,0–5,9 → 35 IE/kg IV &nbsp;|&nbsp; INR ≥6,0 → 50 IE/kg IV<br>Max. 3.000 IE (bis 5.000 IE bei KG >100 kg) &nbsp;·&nbsp; <strong>Ziel-INR &lt;1,3</strong>",
        "<strong>Vitamin K 10 mg</strong> als langsame IV-Infusion (20 min in NaCl 0,9%)<br>Cave: Anaphylaxierisiko bei Schnellinjektion",
        "INR-Kontrolle nach 15–30 min · Bei fehlendem Ansprechen PPSB wiederholen",
        "FFP (15 ml/kg) nur wenn PCC nicht verfügbar (langsamer, höheres Volumen)"
      ]
    },
    {
      "id": "dabi",
      "cat": "DTI",
      "icon": "",
      "name": "Dabigatran (Direkter Thrombin-Inhibitor)",
      "brands": "Pradaxa®",
      "steps": [
        "<strong>Idarucizumab (Praxbind®) 5 g IV:</strong><br>2 × 2,5-g-Flaschen (je 50 ml) als Kurzinfusion ≤15 min oder Bolus<br>Vollständige und sofortige Antagonisierung · Wirkdauer ~24 h",
        "Kontrolle: diluted Thrombin Time (dTT) oder Ecarin Clotting Time (ECT)<br><em>Normalisiert = vollständige Neutralisierung</em>",
        "Alternative (wenn nicht verfügbar): 4-Faktor-PCC 50 IE/kg IV off-label",
        "Hämodialyse als Rescue möglich (~60% dialysierbar) – praktisch aufwändig",
        "Dabigatran-Spiegel (ng/ml) bei unklarer Einnahmezeit bestimmen"
      ]
    },
    {
      "id": "fxa",
      "cat": "FXa",
      "icon": "",
      "name": "Faktor-Xa-Inhibitoren",
