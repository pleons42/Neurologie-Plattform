  "toast": [
    {
      "id": "laa",
      "t": "Großgefäßarteriosklerose (LAA)",
      "d": "Stenose >50% oder Verschluss einer Hirnbasisarterie. Ipsilateraler kortikaler oder subkortikaler Infarkt >1,5 cm. Klinisch: TIA/Stroke im gleichen Gebiet, Strömungsgeräusch, Bildgebung ≥50%-Stenose."
    },
    {
      "id": "ce",
      "t": "Kardioembolie (CE)",
      "d": "Kardiale Hochrisikoquelle: Vorhofflimmern/-flattern, mechanische Herzklappe, MI <4 Wo., dilatative CMP, intrakardialer Thrombus, Sick-Sinus, PFO mit R-L-Shunt und TVT/PVT."
    },
    {
      "id": "svo",
      "t": "Kleingefäßverschluss / lakunär (SVO)",
      "d": "Klassisches lakunäres Syndrom. Singuläre DWI/CT-Läsion ≤1,5 cm subkortikal oder Hirnstamm. Kein kortikaler Infarkt. Risikofaktoren: Hypertonie, Diabetes. Keine ≥50%-Stenose."
    },
    {
      "id": "other",
      "t": "Andere bestimmte Ätiologie",
      "d": "Nicht-atherosklerotische Vaskulopathie (Dissektion, Vaskulitis, CADASIL, Moyamoya), Hyperkoagulabilität (APS, Protein-C/S-Mangel), hämatologische Erkrankungen (PV, Sichelzelle)."
    },
    {
      "id": "crypto",
      "t": "Unbestimmte / kryptogene Ätiologie (ESUS)",
      "d": "Negative vollständige Abklärung oder inkomplette Diagnostik oder ≥2 Ursachen identifiziert. ESUS (Hart 2014): nicht-lakunär + keine ≥50%-Stenose + keine kardiale Hochrisikoquelle + kein anderer Mechanismus."
    }
  ],
